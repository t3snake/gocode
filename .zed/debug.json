// Project-local debug tasks
// see: https://zed.dev/docs/debugger
[
  {
    "label": "TUI Mode",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "${ZED_WORKTREE_ROOT}/src/"
  },
  {
    "label": "Prompt Mode",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    // For Delve, the program can be a package name
    "program": "./src",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["-p", "hello"]
  }
]
